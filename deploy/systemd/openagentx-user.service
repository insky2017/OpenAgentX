[Unit]
Description=OpenAgentX control plane and command center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=OPENAGENTX_HTTP_ADDR=0.0.0.0:18100
EnvironmentFile=-%h/.openagentx/openagentx.env
WorkingDirectory=%h/.openagentx
ExecStart=%h/.local/bin/openagentx serve --db %h/.openagentx/data/openagentx.db --socket %h/.openagentx/run/openagentx.sock --http-addr ${OPENAGENTX_HTTP_ADDR} --web-dir %h/.openagentx/web
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.openagentx

[Install]
WantedBy=default.target
