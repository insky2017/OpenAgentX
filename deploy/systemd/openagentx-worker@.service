[Unit]
Description=OpenAgentX Worker (%i)
After=openagentx.service
Requires=openagentx.service

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/openagentx
# Keep Runtime startup independent from an interactive shell. Per-instance
# AGY paths and optional proxy config belong in this instance EnvironmentFile.
Environment=PATH=/opt/openagentx/bin:/usr/local/libexec/openagentx:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/openagentx/workers/%i.env
ExecStart=/opt/openagentx/bin/openagentx worker run --config /etc/openagentx/workers/%i.yaml
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openagentx /run/openagentx

[Install]
WantedBy=multi-user.target
