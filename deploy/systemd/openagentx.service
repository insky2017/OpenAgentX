[Unit]
Description=OpenAgentX daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/openagentx
ExecStart=/opt/openagentx/bin/openagentx daemon --db /var/lib/openagentx/openagentx.db --socket /run/openagentx/openagentx.sock
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openagentx /run/openagentx

[Install]
WantedBy=multi-user.target
