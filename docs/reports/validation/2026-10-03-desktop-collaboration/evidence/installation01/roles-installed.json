{
  "organization_id": "default",
  "rules": [
    {
      "scope": "pay.registration",
      "owner_agent_id": "oneaxe-pay",
      "description": "负责应用在支付系统中的登记。"
    },
    {
      "scope": "pay.payment_api",
      "owner_agent_id": "oneaxe-pay",
      "description": "负责支付接口及其调用契约。"
    },
    {
      "scope": "pay.callback_protocol",
      "owner_agent_id": "oneaxe-pay",
      "description": "负责支付回调协议；不承接业务应用的接收器部署。"
    },
    {
      "scope": "pay.fund_records",
      "owner_agent_id": "oneaxe-pay",
      "description": "负责支付与资金记录及相应查询核对。"
    },
    {
      "scope": "pay.credential_handoff",
      "owner_agent_id": "oneaxe-pay",
      "description": "负责支付凭据的受控交接；消息正文不得包含凭据明文。"
    },
    {
      "scope": "rhythm.user_mapping",
      "owner_agent_id": "rhythm",
      "description": "负责Rhythm业务用户映射。"
    },
    {
      "scope": "rhythm.login_migration",
      "owner_agent_id": "rhythm",
      "description": "负责Rhythm登录体系迁移。"
    },
    {
      "scope": "rhythm.entitlement_verification",
      "owner_agent_id": "rhythm",
      "description": "负责Rhythm用户权益核验。"
    },
    {
      "scope": "rhythm.app_db_migration",
      "owner_agent_id": "rhythm",
      "description": "负责Rhythm应用数据库迁移；支付领域Agent不替代执行。"
    },
    {
      "scope": "rhythm.receiver_deployment",
      "owner_agent_id": "rhythm",
      "description": "负责Rhythm支付回调接收器部署及应用侧验证。"
    }
  ]
}
